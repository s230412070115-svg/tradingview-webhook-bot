# Скопируйте в .env и замените секрет до того, как откроете URL в интернет.
# Этот пример нельзя использовать в режимах testnet и live.

WEBHOOK_SECRET=change-me-please-123

# paper   — локальная симуляция, биржа не вызывается
# testnet — ордера на Binance Spot Testnet через ccxt
# live    — реальные деньги; дополнительно нужен CONFIRM_LIVE
TRADING_MODE=paper
CONFIRM_LIVE=

EXCHANGE_ID=binance
API_KEY=
API_SECRET=

# Доля свободного депозита в котируемой валюте на одну покупку.
POSITION_SIZE_PCT=1
# 0 отключает проверку. Иначе рыночная цена не должна уйти от цены сигнала больше чем на этот процент.
MAX_DEVIATION_PCT=2

PAPER_QUOTE=USDT
PAPER_BALANCE=10000

# Для локального запуска оставьте 127.0.0.1. Для Render/Railway поставьте 0.0.0.0.
HOST=127.0.0.1
PORT=5000

DB_PATH=trades.sqlite3
LOG_PATH=bot.log
