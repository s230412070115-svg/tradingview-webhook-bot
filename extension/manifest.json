{
  "manifest_version": 3,
  "name": "Бумажный счёт",
  "version": "1.0.0",
  "description": "Панель бумажной торговли рядом с Axiom. Не нажимает кнопки сайта и не читает ключи кошелька.",
  "permissions": ["sidePanel"],
  "host_permissions": ["http://127.0.0.1:5000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Открыть бумажный счёт"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://axiom.trade/*", "https://*.axiom.trade/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
