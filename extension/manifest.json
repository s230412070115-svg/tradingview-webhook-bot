{
  "manifest_version": 3,
  "name": "Проверка токена",
  "version": "1.3.0",
  "description": "Карточка публичной проверки токена поверх Axiom. Не хранит ключи и не отправляет реальные сделки.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": [
    "https://api.rugcheck.xyz/*",
    "https://api.dexscreener.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Проверка токена"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://axiom.trade/*", "https://*.axiom.trade/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["overlay.html", "overlay.css", "overlay.js", "paper.js"],
      "matches": ["https://axiom.trade/*", "https://*.axiom.trade/*"]
    }
  ]
}
